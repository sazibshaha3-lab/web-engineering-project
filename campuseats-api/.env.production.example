APP_NAME=CampusEats
APP_ENV=production
APP_KEY=               # run: php artisan key:generate --show   (paste the base64:... value)
APP_DEBUG=false
APP_URL=https://YOUR-API.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=               # from Aiven
DB_PORT=               # from Aiven (not 3306)
DB_DATABASE=defaultdb  # from Aiven
DB_USERNAME=           # from Aiven
DB_PASSWORD=           # from Aiven
MYSQL_ATTR_SSL_CA=/var/www/html/certs/aiven-ca.pem

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180 # must stay longer than the worker timeout (150 seconds)

CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Email OTP requires a real SMTP provider. Configure its production credentials in Render.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS=YOUR_VERIFIED_SENDER
MAIL_FROM_NAME=CampusEats
ADMIN_REGISTRATION_CODE= # Leave unset in production to keep admin signup disabled; set only for trusted staging.
AUTH_RATE_LIMIT=10     # login and registration attempts per minute
SANCTUM_EXPIRATION=10080 # personal access token lifetime in minutes (7 days)
RUN_SEED=false         # keep false in production; the bundled seeder contains demo/test accounts and data
SEED_DEMO_ACCOUNTS=false # do not load demo accounts in production
